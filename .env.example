# Google Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Google Sheets CRM Destination
# Found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID="your_google_sheet_id_here"
SPREADSHEET_RANGE="Lead_Inquiries_2026!A:F"

# Gmail Search Query Filter
GMAIL_SEARCH_QUERY="is:unread label:INBOX"

# Google OAuth Paths
GOOGLE_CREDENTIALS_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"

